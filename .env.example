# Public site URL used for canonical/sitemap absolute links
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Optional server-only override used by API origin checks
SITE_URL=

# Optional Telegram handle for order CTA (no @). Defaults to live-observed Clarky_AU when unset.
NEXT_PUBLIC_TELEGRAM_ORDER_HANDLE=

# Server-only contact delivery (M3). Production fails closed unless Resend is configured.
# The memory adapter is for local/preview tests only; opt into it explicitly when NODE_ENV=production.
CONTACT_DELIVERY_MODE=
CONTACT_FROM_EMAIL=
CONTACT_TO_EMAIL=
RESEND_API_KEY=

# Must match the browser origin used in local/preview for CSRF-ish origin checks.
# NEXT_PUBLIC_SITE_URL is also used for this comparison.
